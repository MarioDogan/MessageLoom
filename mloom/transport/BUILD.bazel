load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "MLOOM_COPTS")

package(default_visibility = ["//visibility:public"])

# Transport abstraction: endpoints, pub/sub sockets, pollers and the MessageQueue factory.
cc_library(
    name = "transport",
    srcs = ["endpoint.cpp"],
    hdrs = [
        "endpoint.hpp",
        "message_queue.hpp",
        "socket.hpp",
    ],
    copts = MLOOM_COPTS,
    deps = ["//mloom/core"],
)

cc_test(
    name = "endpoint_test",
    size = "small",
    srcs = ["endpoint_test.cpp"],
    copts = MLOOM_COPTS,
    deps = [
        ":transport",
        "@googletest//:gtest_main",
    ],
)
